+"""Time range parsing shared by the standalone observability tool groups."""
+import logging
+from datetime import datetime
+from typing import Optional
+
+from core.config import DEFAULT_TIME_RANGE_DAYS
+from core.llm_client import extract_time_range_with_info
+
+logger = logging.getLogger(__name__)
+
+
+def resolve_time_range(
+    time_range: Optional[str] = None,
+    start_datetime: Optional[str] = None,
+    end_datetime: Optional[str] = None,
+) -> tuple[int, int]:
+    """Resolve natural language or ISO input to an epoch range."""
+    try:
+        if time_range:
+            start_ts, end_ts, _info = extract_time_range_with_info(time_range, None, None)
+            return start_ts, end_ts
+        if start_datetime and end_datetime:
+            start_ts = int(datetime.fromisoformat(start_datetime.replace("Z", "+00:00")).timestamp())
+            end_ts = int(datetime.fromisoformat(end_datetime.replace("Z", "+00:00")).timestamp())
+            return start_ts, end_ts
+        end_ts = int(datetime.utcnow().timestamp())
+        return end_ts - DEFAULT_TIME_RANGE_DAYS * 24 * 3600, end_ts
+    except Exception as exc:
+        logger.warning("Could not parse time range; using default: %s", exc)
+        end_ts = int(datetime.utcnow().timestamp())
+        return end_ts - DEFAULT_TIME_RANGE_DAYS * 24 * 3600, end_ts
