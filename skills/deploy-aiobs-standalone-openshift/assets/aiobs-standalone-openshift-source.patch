+def list_summarization_models() -> List[Dict[str, Any]]:
+    """Return model metadata used by the console settings interface."""
+    try:
+        from core.model_config_manager import get_model_config as load_model_config
+        config = load_model_config()
+        models = []
+        for name, entry in config.items():
+            models.append({
+                "name": name,
+                "external": entry.get("external", True),
+                "requiresApiKey": entry.get("requiresApiKey", True),
+                "provider": entry.get("provider", "unknown"),
+                "modelName": entry.get("modelName", name),
+                **({"serviceName": entry["serviceName"]} if "serviceName" in entry else {}),
+                **({"description": entry["description"]} if "description" in entry else {}),
+            })
+        return make_mcp_text_response(json.dumps({"models": models}))
+    except Exception as exc:
+        logger.warning("Could not list summarization models: %s", exc)
+        return make_mcp_text_response(json.dumps({"models": []}))
