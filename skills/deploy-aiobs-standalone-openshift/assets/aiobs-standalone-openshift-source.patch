diff --git a/src/core/metric_scope.py b/src/core/metric_scope.py
new file mode 100644
index 0000000..06ae2ed
--- /dev/null
+++ b/src/core/metric_scope.py
@@ -0,0 +1,39 @@
+"""Standalone OpenShift metrics scope: exclude GPU and model-serving families."""
+import re
+
+_EXCLUDED_METRIC = re.compile(
+    r"(?:^|[^a-z0-9])(?:vllm|dcgm|gpu|nvidia|habanalabs|habana|gaudi|rocm|amd_smi|accelerator|"
+    r"xpu|cuda|nvml|amdgpu)(?:$|[^a-z0-9])",
+    re.IGNORECASE,
+)
+
+
+def is_excluded_metric_name(name: str) -> bool:
+    return bool(name and _EXCLUDED_METRIC.search(name))
+
+
+def is_excluded_query(query: str) -> bool:
+    """Return true when a PromQL expression names or broadly selects excluded families."""
+    source = query or ""
+    selectors = re.findall(r"__name__\s*(=~|=)\s*(['\"])(.*?)\2", source)
+    for operator, _quote, value in selectors:
+        if operator == "=~" or is_excluded_metric_name(value):
+            return True
+    without_strings = re.sub(r"(['\"]).*?\1", " ", source)
+    identifiers = re.findall(r"[A-Za-z_:][A-Za-z0-9_:]*", without_strings)
+    return any(is_excluded_metric_name(token) for token in identifiers)
+
+
+def filter_metric_map(metrics: dict) -> dict:
+    """Copy metric groups while dropping excluded categories and query families."""
+    filtered = {}
+    for category, entries in (metrics or {}).items():
+        if is_excluded_metric_name(category) or not isinstance(entries, dict):
+            continue
+        safe_entries = {
+            label: query for label, query in entries.items()
+            if not is_excluded_metric_name(str(label)) and not is_excluded_query(str(query))
+        }
+        if safe_entries:
+            filtered[category] = safe_entries
+    return filtered
