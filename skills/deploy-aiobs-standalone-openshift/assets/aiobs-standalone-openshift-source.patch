diff --git a/openshift-plugin/__tests__/pages/OpenShiftOnlyDashboard.test.tsx b/openshift-plugin/__tests__/pages/OpenShiftOnlyDashboard.test.tsx
new file mode 100644
index 0000000..719b1dc
--- /dev/null
+++ b/openshift-plugin/__tests__/pages/OpenShiftOnlyDashboard.test.tsx
@@ -0,0 +1,33 @@
+import * as React from 'react';
+import '@testing-library/jest-dom';
+import { fireEvent, render, screen } from '@testing-library/react';
+import AIObservabilityPage from '../../src/core/pages/AIObservabilityPage';
+import * as fs from 'fs';
+import * as path from 'path';
+
+jest.mock('../../src/core/pages/OpenShiftMetricsPage', () => () => <div data-testid="openshift-metrics">Cluster metrics view</div>);
+jest.mock('../../src/core/pages/AIChatPage', () => () => <div data-testid="openshift-chat">OpenShift scoped chat</div>);
+jest.mock('../../src/core/components/SettingsModal', () => ({ SettingsModal: ({ isOpen }: { isOpen: boolean }) => isOpen ? <div data-testid="maas-settings">MaaS settings</div> : null }));
+jest.mock('../../src/core/services/runtimeConfig', () => ({ initializeRuntimeConfig: jest.fn().mockResolvedValue(undefined) }));
+jest.mock('../../src/core/services/mcpClient', () => ({ getSessionConfig: () => ({ ai_model: 'maas/gpt-oss-20b' }) }));
+
+describe('standalone OpenShift dashboard', () => {
+  it('shows only OpenShift metrics and chat, and allows MaaS settings', () => {
+    render(<AIObservabilityPage />);
+    expect(screen.getByRole('tab', { name: 'OpenShift Metrics' })).toBeInTheDocument();
+    expect(screen.getByRole('tab', { name: 'Chat' })).toBeInTheDocument();
+    expect(screen.queryByText(/vLLM|Accelerator|GPU/i)).not.toBeInTheDocument();
+    expect(screen.getByTestId('openshift-metrics')).toBeInTheDocument();
+
+    fireEvent.click(screen.getByRole('tab', { name: 'Chat' }));
+    expect(screen.getByTestId('openshift-chat')).toBeInTheDocument();
+    fireEvent.click(screen.getByRole('button', { name: /Settings/ }));
+    expect(screen.getByTestId('maas-settings')).toBeInTheDocument();
+  });
+
+  it('does not register a vLLM console route', () => {
+    const serialized = fs.readFileSync(path.resolve(__dirname, '../../console-extensions.json'), 'utf8');
+    expect(serialized).not.toMatch(/vllm|VLLMMetricsPage/i);
+    expect(serialized).toContain('AIObservabilityPage');
+  });
+});
